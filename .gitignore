# ==========================================
# ReconOS — Comprehensive .gitignore
# ==========================================

# ------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------
.env
.env.local
.env.*.local
*.env
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# ------------------------------------------
# Node.js & Frontend (Next.js)
# ------------------------------------------
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
build/
frontend/build/
dist/
frontend/dist/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Next.js telemetry / bundle analysis
.next/cache/
next-env.d.ts.bak

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# ------------------------------------------
# Python & Backend (FastAPI / SQLAlchemy)
# ------------------------------------------
__pycache__/
backend/**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
dist/
downloads/
eggs/
# Python package build dirs (keep frontend/src/lib)
backend/**/lib/
backend/**/lib64/
!frontend/src/lib/**
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
backend/venv/
backend/.venv/
env/
ENV/
env.bak/
venv.bak/

# Databases
*.sqlite
*.sqlite3
*.db
reconos.db
backend/reconos.db

# Testing & Coverage
.pytest_cache/
backend/.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/

# ------------------------------------------
# Operating System & IDE Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ------------------------------------------
# Temporary & Generated Artifacts
# ------------------------------------------
.system_generated/
.tempmediaStorage/
.user_uploaded/
scratch/
*.tmp
