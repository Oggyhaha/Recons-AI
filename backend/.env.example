# ReconOS Backend Configuration
PROJECT_NAME="ReconOS — AI Finance Control Plane"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration
# Option 1: PostgreSQL with pgvector (Recommended for Production & Docker)
DATABASE_URL="postgresql+asyncpg://reconos:reconos_password@localhost:5432/reconos"
# Option 2: SQLite (Instant zero-dependency local dev)
# DATABASE_URL="sqlite+aiosqlite:///./reconos.db"

# Financial Operational Parameters
DEFAULT_CURRENCY="INR"
AMOUNT_TOLERANCE_PAISE=200         # ₹2.00 rounding tolerance
SETTLEMENT_WINDOW_DAYS=2           # T+2 Razorpay settlement calendar
HIGH_RISK_THRESHOLD_PAISE=5000000   # ₹50,000 threshold for mandatory human review
CRITICAL_RISK_THRESHOLD_PAISE=20000000 # ₹200,000 threshold for critical break

# AI & LLM Engine (Optional: Works offline with deterministic high-quality reasoning)
GEMINI_API_KEY=""                  # Optional: Google Gemini Flash API Key
OPENAI_API_KEY=""                  # Optional: OpenAI API Key
MOCK_AI_FALLBACK=true

# Security & Provenance
SECRET_KEY="reconos-enterprise-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
